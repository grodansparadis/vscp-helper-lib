 int
+VscpRemoteTcpIf::setBinarySecurity(uint8_t algorithm, const uint8_t *key, size_t keyLength,
+                                   const uint8_t *hmacKey, size_t hmacKeyLength)
+{
+  logTcpEntry(__func__);
+  if (isConnected() && m_bBinaryMode) {
+    return logTcpResult(__func__, VSCP_ERROR_PARAMETER);
+  }
+  if (algorithm == VSCP_ENCRYPTION_NONE) {
+    if (keyLength || hmacKeyLength) {
+      return logTcpResult(__func__, VSCP_ERROR_PARAMETER);
+    }
+  }
+  else {
+    const size_t required = algorithm == VSCP_ENCRYPTION_AES128 ? 16 :
+                            algorithm == VSCP_ENCRYPTION_AES192 ? 24 :
+                            algorithm == VSCP_ENCRYPTION_AES256 ? 32 : 0;
+    if (!required || !key || keyLength != required || !hmacKey || hmacKeyLength != 32 ||
+        CRYPTO_memcmp(key, hmacKey, required) == 0) {
+      return logTcpResult(__func__, VSCP_ERROR_PARAMETER);
+    }
+  }
+  OPENSSL_cleanse(m_binaryKey.data(), m_binaryKey.size());
+  OPENSSL_cleanse(m_binaryHmacKey.data(), m_binaryHmacKey.size());
+  if (algorithm != VSCP_ENCRYPTION_NONE) {
+    std::copy(key, key + keyLength, m_binaryKey.begin());
+    std::copy(hmacKey, hmacKey + hmacKeyLength, m_binaryHmacKey.begin());
+  }
+  m_binaryEncryption = algorithm;
+  return logTcpResult(__func__, VSCP_ERROR_SUCCESS);
+}
